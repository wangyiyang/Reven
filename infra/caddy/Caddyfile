http://dev.wangyiyang.cc:3001 {
	# 全站安全响应头（#75）：Caddy 直出静态页不经 uvicorn，静态/API 统一在此设置；
	# 用 ? 前缀（仅在缺失时写入，且延迟到响应写出时才执行）：API 响应已由
	# SecurityHeadersMiddleware 设置的保留上游值，静态页由 Caddy 补上，两端都不会重复
	header {
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "SAMEORIGIN"
	}

	handle /api/* {
		reverse_proxy reven:8000
	}

	# 指纹资产长缓存；HTML/SPA 入口 no-cache——否则部署后浏览器继续跑旧 bundle
	#（2026-08-25 实测：发版后页面仍加载旧 index-*.js，需强刷才拿到新包）
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/reven/current
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		root * /srv/reven/current
		try_files {path} /index.html
		file_server
	}
}
