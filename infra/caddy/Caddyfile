# 公共站点逻辑（HTTPS 主站与过渡期 :3001 共用），通过 snippet 复用避免两处漂移
#
# 部署形态（2026-10-05 起）：VPS 纯 API 反代，不再服务前端静态文件——
# 前端唯一入口是 Vercel，非 /api 路径一律 404。镜像仍构建 web 产物供
# 自托管形态（infra/self-host）使用，两者互不影响。
(site_common) {
	# 全站安全响应头（#75）：Caddy 直出的响应（兜底 404 等）不经 uvicorn，与 API 统一在此设置；
	# 用 ? 前缀（仅在缺失时写入，且延迟到响应写出时才执行）：API 响应已由
	# SecurityHeadersMiddleware 设置的保留上游值，Caddy 直出响应在此补上，两端都不会重复
	header {
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "SAMEORIGIN"
	}

	handle /api/* {
		reverse_proxy reven:8000
	}

	# 兜底：前端静态文件只由 Vercel 服务，非 /api 路径一律 404
	handle {
		respond 404
	}
}

# HTTPS 主站（2026-10-01 全站 TLS 化，Caddy 自动签发证书；签发依赖公网可达 80/443）
dev.wangyiyang.cc {
	import site_common
}

# 过渡期保留的 HTTP 入口（TLS 验证通过、PUBLIC_BASE_URL 切换后可下线）
http://dev.wangyiyang.cc:3001 {
	import site_common
}
