# Modified for Reven: allow only bubblewrap's temporary mount layout and pivots.
#include <tunables/global>

profile reven-self-host flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=reven-self-host,
  ptrace (trace,read,tracedby,readby) peer=reven-self-host,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Bubblewrap 0.8 first makes the new namespace private from the container.
  mount options=(rw, rslave, silent) -> /,
  mount options=(rw, rprivate, silent) -> /oldroot/,
  mount fstype=tmpfs -> /tmp/,
  mount fstype=tmpfs -> /newroot/**,
  mount fstype=devpts -> /newroot/dev/pts/,
  mount options=(rw, rbind) -> /tmp/newroot/,
  mount options=(rw, rbind) -> /newroot/**,
  mount options=(rw, bind) -> /newroot/**,
  # Bind remounts preserve source flags while always enforcing nosuid.
  mount options=(bind, remount, nosuid, silent) options in (ro, nodev, noexec, noatime, nodiratime, relatime) -> /newroot/**,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
}
