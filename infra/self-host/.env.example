# Copy to infra/self-host/.env; never commit or share the completed file.
# Use your domain and standard HTTPS port for public deployment.
REVEN_PUBLIC_BASE_URL=https://reven.example.com
# Generate a hex password: openssl rand -hex 32 (embedded in a database URI).
POSTGRES_PASSWORD=
# Generate the encryption key: openssl rand -base64 32; keep it with your backups.
REVEN_MASTER_KEY=
# Generate the login password: openssl rand -hex 24.
REVEN_ADMIN_PASSWORD=

# Optional: run the published image instead of building from source.
# Add -f infra/self-host/compose.image.yml to the compose file list (see docs/self-hosting.md)
# and pin the exact digest from the release notes:
# REVEN_IMAGE=ghcr.io/wangyiyang/reven@sha256:<64-hex>

# Optional RSS model review / fallback translation. Configure other integrations in the UI.
# Leave these commented out when unused; an empty key is not a configured integration.
# SILICONFLOW_API_KEY=
# SILICONFLOW_CHAT_MODEL=Qwen/Qwen3-8B
# RSS_MODEL_REVIEW_ENABLED=true
# Agent 的模型凭据在集成页管理；执行状态保存在 PostgreSQL，不需要 Workspace。
# AGENT_RUN_TIMEOUT_SECONDS=180

# Optional COS storage for brand assets (not needed for RSS materials).
# COS_BUCKET=
# COS_REGION=
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_PUBLIC_BASE_URL=
# COS_ASSET_PREFIX=assets/sha256
