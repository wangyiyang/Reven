# DeepSeek API 配置
# 从 https://platform.deepseek.com/api_keys 获取
# cp .env.example .env 后填入真实值
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# LLM 插件口参数（以下为推荐默认值，可按需修改）
LLM_MAX_TOKENS=65536
LLM_MODEL_DEFAULT=deepseek-v4-flash
LLM_MODEL_FALLBACK=deepseek-v4-pro
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_CONFIDENCE_CAP=0.8
CONFIRMATION_THRESHOLD=0.6
