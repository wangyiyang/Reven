[importlinter]
root_package = reven
include_external_packages = true
include_local = true

# Rule 1: 领域之间禁止互相 import（独立约束）
[importlinter:contract:domains-isolated]
name = 领域间禁止互相 import
type = independence
modules =
    reven.domains.masterdata
    reven.domains.sales
    reven.domains.inventory
    reven.domains.incentive

# Rule 2: 领域/核心/指标层禁止依赖适配器
[importlinter:contract:domain-adapters-isolation]
name = 领域/核心/指标层禁止依赖适配器
type = forbidden
source_modules =
    reven.domains
    reven.kernel
    reven.metrics
forbidden_modules =
    reven.adapters
    lark_oapi

# Rule 3: 智能层只能 import 指标层与工具契约
[importlinter:contract:intelligence-boundary]
name = 智能层禁止越界 import
type = forbidden
source_modules = reven.intelligence
forbidden_modules =
    reven.domains
    reven.kernel
    reven.adapters
    reven.importing
